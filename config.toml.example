# Riply Configuration
# Place this file at ~/.config/riply/config.toml (or $XDG_CONFIG_HOME/riply/config.toml).
# Riply creates a default config there automatically on first run.

# Directory where ripped movies will be stored (Jellyfin-compliant structure)
movies_dir = "/media/movies"

# Directory where ripped TV shows will be stored ("Show (Year)/Season N/…").
# Empty = TV shows are stored under movies_dir.
tv_shows_dir = ""

# Temporary directory for rip operations
temp_dir = "/tmp/riply"

# Metadata providers ([metadata]/[providers] take effect without a restart).
# The per-media-type lists give the try-order: the first entry is the primary
# provider; on error or empty results the next one is tried. Providers with a
# key but absent from a list are appended after it.
[metadata]
movies = ["tmdb", "omdb"]
tv = ["tmdb", "omdb"]

[providers.tmdb]
# TMDb API key for auto-naming — get one at https://www.themoviedb.org/settings/api
api_key = ""

[providers.omdb]
# OMDb API key — get one at https://www.omdbapi.com/apikey.aspx
api_key = ""

# A legacy flat "tmdb_api_key = ..." is migrated into [providers.tmdb]
# automatically on load and no longer needs to be set here.

# HTTP server settings (http_host/http_port/makemkv_path take effect on restart)
http_host = "127.0.0.1"
http_port = 3000

# MakeMKV binary path (empty = use PATH lookup)
makemkv_path = ""

# Pre-fill the search modal from the last ripped title (default true)
auto_sequence = true

# Automatically eject after a successful accept and start ripping newly inserted discs (default true)
autorip = true

# Skip titles shorter than this many seconds (makemkvcon --minlength).
# Titles shorter than the limit are assumed to be intros/adverts and are not
# ripped. 0 = rip every title (omit the flag). Default 300 (5 minutes).
min_title_length = 300
