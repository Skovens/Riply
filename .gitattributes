# Auto detect text files and perform LF normalization
* text=auto

# Rust source files
*.rs text diff=rust

# TOML config files
*.toml text

# Markdown files
*.md text

# Shell scripts
*.sh text eol=lf

# JSON files
*.json text

# YAML files
*.yml text
*.yaml text

# Svelte/JS/TS files
*.svelte text
*.js text
*.ts text

# CSS files
*.css text

# Prevent diff for binary files
*.db binary
*.db-shm binary
*.db-wal binary
*.rlib binary
*.png binary
*.jpg binary
*.ico binary
